---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import DaySection from "../../components/DaySection.astro";
import Filters from "../../components/Filters.astro";
import IrregularSection from "../../components/IrregularSection.astro";
import { loadSiteData } from "../../lib/data.js";
import { osloDate } from "../../lib/date.js";
import { isUndated, occursOn } from "../../lib/occurrence.js";
import { placeSummary } from "../../lib/model.js";
import { fylkeOf, legacyFylkeSlugs } from "../../lib/place.js";
import { quizCount } from "../../lib/format.js";
import { href } from "../../lib/url.js";

/**
 * Counties, plus a redirect page for every county the source still names but that no longer
 * exists. The redirects are derived from the data, so they appear and disappear on their own
 * rather than being maintained by hand.
 */
export const getStaticPaths = (async () => {
  const { items, slugs, venues } = await loadSiteData();

  const counties = [...slugs.byFylke].map(([fylke, slug]) => ({
    params: { fylke: slug },
    props: {
      fylke,
      items: items.filter((item) => fylkeOf(item.venue) === fylke),
      redirectTo: null as string | null,
    },
  }));

  const byName = new Map([...slugs.byFylke].map(([name, slug]) => [slug, name]));
  const legacy = [...legacyFylkeSlugs(venues)].map(([from, to]) => ({
    params: { fylke: from },
    props: { fylke: byName.get(to) ?? "", items: [], redirectTo: to },
  }));

  return [...counties, ...legacy];
}) satisfies GetStaticPaths;

const { fylke, items, redirectTo } = Astro.props;
const { slugs, meta } = await loadSiteData();

const target = redirectTo ? href("fylke", redirectTo) : null;

const today = osloDate();
const tonight = items.filter((item) => occursOn(item.quiz, today));
const irregular = items.filter((item) => isUndated(item.quiz));
const places = placeSummary(items);
---

{
  target ? (
    <html lang="nb">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <link rel="canonical" href={target} />
        <meta name="robots" content="noindex, follow" />
        <title>{fylke} – quizkveld</title>
      </head>
      <body>
        <p>
          Fylket dette het før 2020 finnes ikke lenger. Quizene ligger nå under{" "}
          <a href={target}>{fylke}</a>.
        </p>
      </body>
    </html>
  ) : (
    <Base
      title={`Pubquiz i ${fylke} – quizkveld`}
      description={`Alle pubquizer i ${fylke}, sted for sted.`}
      generatedAt={meta.generatedAt}
      sourceUpdatedAt={meta.sourceUpdatedAt}
    >
      <p class="breadcrumbs">
        <a href={href()}>Forsiden</a> ›<a href={href("steder")}>Steder</a> ›<span>{fylke}</span>
      </p>

      <div class="intro">
        <h1>Pubquiz i {fylke}</h1>
        <p>
          {quizCount(items.length)} på {places.length} steder. Kilden bruker fylkesnavnene fra
          før sammenslåingen i 2020; her er de slått sammen til dagens inndeling.
        </p>
        <ul class="place-grid">
          {places.map((place) => (
            <li>
              <a href={href("sted", slugs.bySted.get(place.sted) ?? "")}>{place.sted}</a>{" "}
              <span class="place-grid__count">({place.count})</span>
            </li>
          ))}
        </ul>
      </div>

      <Filters items={items} showPlace={true} />

      <DaySection
        date={today}
        today={today}
        items={tonight}
        slugs={slugs}
        grouping="sted"
        emptyText={`Ingen faste quizer i ${fylke} i kveld.`}
      />

      <IrregularSection items={irregular} slugs={slugs} grouping="sted" scope={`i ${fylke}`} />
    </Base>
  )
}
